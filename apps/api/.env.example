# Server-only secrets. Set them in Vercel project settings, never in the web app.
SUPABASE_URL=https://auth.example.com
SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Fallback model (Alibaba Qwen, international endpoint). Leave empty to disable.
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
AI_DAILY_QUOTA=20
ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com
