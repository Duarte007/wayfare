# Public values only: they ship in the browser bundle.
# Use our own auth domain (Supabase custom domain), never *.supabase.co, so a blocked third-party
# domain on some networks can't break sign-in.
VITE_SUPABASE_URL=https://auth.example.com
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=https://api.example.com
